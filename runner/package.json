{
  "name": "ai-pr-review-cloud-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Per-PR review runner built on the pi SDK",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
