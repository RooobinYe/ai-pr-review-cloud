    "start": "node dist/main.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "typebox": "1.3.27",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
